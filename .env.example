# Backend selection: true = in-memory demo API (no backend), false = Supabase.
VITE_USE_MOCK=false

# Supabase project (Dashboard -> Project Settings -> API Keys).
# Only the PUBLISHABLE key goes here; it is safe in the browser because every table is behind RLS.
# Never put the secret / service_role key in any NEXT_PUBLIC_* or VITE_* variable (the app refuses to start).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Display timezone for dates (requests are numbered and filtered by Jakarta calendar day).
VITE_TIMEZONE=Asia/Jakarta

# Optional: where "Forgot Password?" sends people. Leave empty to show "ask your administrator".
VITE_SUPPORT_EMAIL=
